{
  "name": "codeddesign",
  "version": "0.1.5",
  "private": true,
  "description": "Build your apps with a unique-looking design system from CodedGuy.",
  "scripts": {
    "dump-llms": "tsx scripts/dump-llms.ts",
    "build": "npm run dump-llms && node scripts/build.js && tsc -p tsconfig.build.json && node scripts/verify-dist.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./agent": "./src/agent.ts",
    "./llms.txt": "./llms.txt",
    "./SYSTEM.md": "./SYSTEM.md",
    "./theme": "./src/theme/index.ts",
    "./tokens/colors.stylex": "./src/tokens/colors.stylex.ts",
    "./tokens/typography.stylex": "./src/tokens/typography.stylex.ts",
    "./tokens/space.stylex": "./src/tokens/space.stylex.ts",
    "./tokens/shadows.stylex": "./src/tokens/shadows.stylex.ts",
    "./tokens/stroke.stylex": "./src/tokens/stroke.stylex.ts"
  },
  "peerDependencies": {
    "@stylexjs/stylex": "0.19.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/fredoka": "^5.2.10",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/nunito": "^5.2.7"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "tsx": "^4.20.5"
  }
}
